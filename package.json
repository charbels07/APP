{
  "name": "caa-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-print": "~58.0.8",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export -p web",
    "fetch:arasaac": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types scripts/fetch-arasaac.ts",
    "build:picto": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types scripts/build-picto-library.ts",
    "test:db": "bash scripts/test-db.sh",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testPathPatterns=live/ --forceExit --runInBand",
    "update:picto": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types scripts/build-picto-library.ts --add-missing"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/live/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
