{
  "name": "caa-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-media-library": "~58.0.13",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^11.1.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "axe-core": "^4.10.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export -p web",
    "build:web": "node scripts/check-web-env.js && EXPO_OFFLINE=1 expo export -p web",
    "fetch:picto": "bash scripts/fetch-pictogram-sources.sh",
    "build:picto": "node --experimental-strip-types scripts/build-pictograms.ts",
    "build:symbols": "node --experimental-strip-types scripts/build-default-symbols.ts",
    "build:voices": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types scripts/build-voice-packs.ts",
    "test:db": "bash scripts/test-db.sh",
    "test:live": "jest --testPathIgnorePatterns=/node_modules/ --testPathPatterns=live/ --forceExit --runInBand",
    "test:a11y": "bash scripts/a11y/run.sh",
    "eas-build-pre-install": "node scripts/check-store-env.js",
    "build:ios": "npx eas-cli build -p ios --profile production",
    "build:android": "npx eas-cli build -p android --profile production",
    "build:preview": "npx eas-cli build -p all --profile preview"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/live/",
      "/.claude/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  }
}
